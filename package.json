{
  "name": "openmonk",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 4444 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4444 --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:e2e": "next start -p 4455 --hostname 127.0.0.1",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "typescript": "^7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "8.5.32",
    "source-map-js": "1.2.2",
    "minimatch": "11.0.3"
  }
}
